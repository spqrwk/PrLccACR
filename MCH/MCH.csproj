<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

        <!-- 指定输出目录（本地开发用，CI 通过 -p:OutputPath=... 覆盖） -->
        <OutputPath>$(APPDATA)\XIVLauncherCN\pluginConfigs\PromeRotation\ACR\LccMch</OutputPath>

        <!-- 不再自动附加 net10.0-windows-->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Action\OffGcd\" />
    </ItemGroup>

    <!-- ============================================================
         编译期 SDK 引用：PromeRotation.SDK.CNGL（国服 API15 自包含引用包）
         - 自带 Dalamud / Lumina / PromeRotation / FFXIVClientStructs 等引用程序集
         - ECommons 作为 NuGet 依赖自动带上
         - 无需本机卫月安装环境，CI 亦可直接编译
         升级 SDK 时只需修改下方 Version。
         ============================================================ -->
    <ItemGroup>
        <PackageReference Include="PromeRotation.SDK.CNGL" Version="0.1.0-preview.3" />
    </ItemGroup>

</Project>
